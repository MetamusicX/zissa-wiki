%% Source for zissa-wiki-overview.png (README, Architecture section).
%% Re-render after editing:
%%   npx -p @mermaid-js/mermaid-cli mmdc -i zissa-wiki-overview.mmd -o zissa-wiki-overview.png -b white -s 2
flowchart LR
    you(["You"])
    agent["Claude Code<br/>follows CLAUDE.md"]

    subgraph RAW["raw/ · written by you"]
        src[("Immutable sources<br/>articles, books, notes,<br/>transcripts, images")]
    end

    subgraph WIKI["wiki/ · written by the LLM"]
        sn["Source notes<br/>one per source"]
        pages["Concepts · Authors<br/>Debates · Themes<br/>Methods · Projects"]
        syn["Syntheses<br/>overviews per cluster"]
    end

    subgraph SCHEMA["schema · you + the LLM"]
        idx["index.md<br/>concept clusters"]
        log["log.md<br/>append-only change log"]
    end

    tool["scripts/wiki.py lint<br/>mechanical checks"]

    you -->|"add a source"| src
    you -->|"ingest · ask · lint"| agent
    src -.->|"read, never modified"| agent
    agent -->|"INGEST"| sn
    agent -->|"INGEST: 10–15 pages"| pages
    agent -->|"when a cluster matures"| syn
    agent -->|"update clusters"| idx
    agent -->|"record every change"| log
    agent -->|"LINT"| tool
    tool -.->|"broken links, orphans,<br/>index drift"| agent
